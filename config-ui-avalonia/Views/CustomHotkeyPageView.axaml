<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyKeymap.Settings.ViewModels"
             xmlns:controls="using:MyKeymap.Settings.Views.Controls"
             x:Class="MyKeymap.Settings.Views.CustomHotkeyPageView"
             x:Name="Root"
             x:DataType="vm:CustomHotkeyPageViewModel">

  <!-- 全局自定义热键页 (复刻 views/CustomHotkey.vue): 左侧热键表 + 右侧示例与编辑面板
       整页内容包 Viewbox Uniform 等比缩放 (背景留在 ScrollViewer 上, 不随缩放):
       内容全固定宽 (336/512/512 + 间距边距 = 920px, 三框各窄 20%), Viewbox 以 Infinity 测量, DesiredSize 稳定;
       显示宽度由 Viewbox MaxWidth=760 封顶: 760/920 ≈ 0.827, 与原铺满版 (936/1132) 缩放比一致,
       因此组件显示宽窄 20% 而显示高度像素不变; 要再调宽度改三框 Width 与 MaxWidth (保持 0.827 比例);
       纵向默认 Auto -> Viewbox 纵向不放大, 内容超高时滚动仍可用 -->
  <ScrollViewer Background="#F0F2F7">
    <Viewbox Stretch="Uniform" MaxWidth="760" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" Margin="24,20,24,28" Spacing="24" VerticalAlignment="Top">

      <!-- 左: 热键表格 (热键 / 备注 / 删除) -->
      <Border Width="336" Background="White" CornerRadius="12" Padding="16"
              VerticalAlignment="Top">
        <DockPanel>
          <!-- 表头 -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <TextBlock Width="110" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=404}" Foreground="#8A8F98" FontSize="12" />
            <TextBlock Width="140" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=305}" Foreground="#8A8F98" FontSize="12" />
            <TextBlock Width="40" />
          </StackPanel>

          <!-- 新增一个 (label:405) -->
          <Button DockPanel.Dock="Bottom" Command="{Binding AddRowCommand}"
                  HorizontalAlignment="Right" Margin="0,12,0,0"
                  Background="Transparent" BorderBrush="#2E7D32" BorderThickness="1"
                  Foreground="#2E7D32" Padding="12,5" CornerRadius="8">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=405}" />
          </Button>

          <!-- 行: 整行可点选中 (复刻 tr @click=checkRow) -->
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomHotkeyRowVm">
                <Grid ColumnDefinitions="110,140,*" Margin="0,1"
                      Background="{Binding RowBackground}"
                      PointerPressed="OnRowPressed">
                  <!-- 热键编辑框 (失焦提交, 复刻 @change=changeCustomHotkey) -->
                  <TextBox Text="{Binding Hotkey}" LostFocus="OnHotkeyLostFocus" GotFocus="OnRowFocused"
                           Watermark="{Binding #Root.((vm:CustomHotkeyPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=957}"
                           Padding="6,4" FontSize="13" />
                  <!-- 备注 (复刻 translate(getActionComment)) -->
                  <TextBlock Grid.Column="1" Text="{Binding Comment}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" FontSize="13" Margin="8,0" />
                  <!-- 删除 (复刻 mdi-delete-outline) -->
                  <Button Grid.Column="2" Content="✕"
                          Command="{Binding #Root.((vm:CustomHotkeyPageViewModel)DataContext).RemoveRowCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" Foreground="#C62828" Padding="6,3"
                          HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- 右: 按键写法说明卡 (合并原 Example 1/2) + 动作编辑面板
           符号规则以 site-assets/config_doc.md 核实为准: ^ ! + # 四个修饰符 (左右修饰 < > 文档未提及, 不列);
           热键中键名直接写 (模板 slow.Map("*space",...) 与原 Example 2 印证), 区别于 KeysToSend 的 {键} 语法 -->
      <StackPanel Spacing="14">
        <Border Width="512" Background="White" CornerRadius="12" Padding="16"
                VerticalAlignment="Top">
          <StackPanel Spacing="8">

            <!-- 标题 (label:1064) -->
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1064}"
                       FontWeight="SemiBold" />

            <!-- 修饰符 (label:1065) -->
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1065}"
                       FontSize="12" Foreground="#8A8F98" />
            <StackPanel Orientation="Horizontal" Spacing="24">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="#" FontFamily="Consolas,Courier New" FontWeight="SemiBold" />
                <TextBlock Text="Win" FontSize="13" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="!" FontFamily="Consolas,Courier New" FontWeight="SemiBold" />
                <TextBlock Text="Alt" FontSize="13" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="^" FontFamily="Consolas,Courier New" FontWeight="SemiBold" />
                <TextBlock Text="Ctrl" FontSize="13" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="+" FontFamily="Consolas,Courier New" FontWeight="SemiBold" />
                <TextBlock Text="Shift" FontSize="13" />
              </StackPanel>
            </StackPanel>

            <!-- 常用按键名 (label:1067) -->
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1067}"
                       FontSize="12" Foreground="#8A8F98" />
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="space" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1068}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="enter" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1069}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="tab" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1070}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="esc" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1071}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="capslock" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1072}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="lbutton" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1073}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="rbutton" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1074}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="F1~F24" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1075}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="a-z 0-9" FontFamily="Consolas,Courier New" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1076}" FontSize="13" Foreground="#5A5F68" />
              </StackPanel>
            </Grid>

            <!-- 更多特殊按键参考 (label:958, 原链接保留) -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=958}"
                         FontSize="13" VerticalAlignment="Center" />
              <Button Command="{Binding OpenKeyListDocCommand}"
                      Background="Transparent" Foreground="#2E7D32" Padding="2,0"
                      Content="reference" />
            </StackPanel>
          </StackPanel>
        </Border>

        <controls:ActionEditorPanel Width="512" DataContext="{Binding Editor}" />
      </StackPanel>

    </StackPanel>
    </Viewbox>
  </ScrollViewer>
</UserControl>

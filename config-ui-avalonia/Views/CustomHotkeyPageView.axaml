<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyKeymap.Settings.ViewModels"
             xmlns:controls="using:MyKeymap.Settings.Views.Controls"
             x:Class="MyKeymap.Settings.Views.CustomHotkeyPageView"
             x:Name="Root"
             x:DataType="vm:CustomHotkeyPageViewModel">

  <!-- 全局自定义热键页 (复刻 views/CustomHotkey.vue): 左侧热键表 + 右侧示例与编辑面板 -->
  <ScrollViewer Background="#F0F2F7">
    <StackPanel Orientation="Horizontal" Margin="24,20,24,28" Spacing="24" VerticalAlignment="Top">

      <!-- 左: 热键表格 (热键 / 备注 / 删除) -->
      <Border Width="420" Background="White" CornerRadius="12" Padding="16"
              VerticalAlignment="Top">
        <DockPanel>
          <!-- 表头 -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <TextBlock Width="110" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=404}" Foreground="#8A8F98" FontSize="12" />
            <TextBlock Width="190" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=305}" Foreground="#8A8F98" FontSize="12" />
            <TextBlock Width="40" />
          </StackPanel>

          <!-- 新增一个 (label:405) -->
          <Button DockPanel.Dock="Bottom" Command="{Binding AddRowCommand}"
                  HorizontalAlignment="Right" Margin="0,12,0,0"
                  Background="Transparent" BorderBrush="#2E7D32" BorderThickness="1"
                  Foreground="#2E7D32" Padding="12,5" CornerRadius="8">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=405}" />
          </Button>

          <!-- 行: 整行可点选中 (复刻 tr @click=checkRow) -->
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomHotkeyRowVm">
                <Grid ColumnDefinitions="110,190,*" Margin="0,1"
                      Background="{Binding RowBackground}"
                      PointerPressed="OnRowPressed">
                  <!-- 热键编辑框 (失焦提交, 复刻 @change=changeCustomHotkey) -->
                  <TextBox Text="{Binding Hotkey}" LostFocus="OnHotkeyLostFocus" GotFocus="OnRowFocused"
                           Watermark="{Binding #Root.((vm:CustomHotkeyPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=957}"
                           Padding="6,4" FontSize="13" />
                  <!-- 备注 (复刻 translate(getActionComment)) -->
                  <TextBlock Grid.Column="1" Text="{Binding Comment}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" FontSize="13" Margin="8,0" />
                  <!-- 删除 (复刻 mdi-delete-outline) -->
                  <Button Grid.Column="2" Content="✕"
                          Command="{Binding #Root.((vm:CustomHotkeyPageViewModel)DataContext).RemoveRowCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" Foreground="#C62828" Padding="6,3"
                          HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- 右: 示例卡片 + 动作编辑面板 -->
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <!-- Example 1 -->
          <Border Width="390" Background="White" CornerRadius="12" Padding="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Example 1" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="!c = Alt + C" FontSize="13" />
              <TextBlock Text="#c = Win + C" FontSize="13" />
              <TextBlock Text="^c = Ctrl + C" FontSize="13" />
              <TextBlock Text="^!c = Ctrl + Alt + C" FontSize="13" />
              <TextBlock Text="^+c = Ctrl + Shift + C" FontSize="13" />
              <TextBlock Text="+!c = Shift + Alt + C" FontSize="13" />
            </StackPanel>
          </Border>
          <!-- Example 2 -->
          <Border Width="390" Background="White" CornerRadius="12" Padding="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Example 2" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="F11 = F11" FontSize="13" />
              <TextBlock Text="!1 = Alt + 1" FontSize="13" />
              <TextBlock Text="+F2 = Shift + F2" FontSize="13" />
              <TextBlock Text="!space = Alt + Space" FontSize="13" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=958}"
                           FontSize="13" VerticalAlignment="Center" />
                <Button Command="{Binding OpenKeyListDocCommand}"
                        Background="Transparent" Foreground="#2E7D32" Padding="2,0"
                        Content="reference" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <controls:ActionEditorPanel DataContext="{Binding Editor}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>

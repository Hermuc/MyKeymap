<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyKeymap.Settings.ViewModels"
             x:Class="MyKeymap.Settings.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">

  <!--
    总览页 (复刻 Home.vue): Vue 版为 <iframe src="/config_doc.html">。
    Avalonia 无内嵌浏览器, 等价实现: 渲染 config_doc.md (config_doc.html 的源),
    保留标题层级/图片/链接; 用户自定义 (config.overviewDocMd) 时优先展示自定义内容;
    拉取失败时回退到内置快速上览引导 (信息完整性保留)。
  -->
  <Grid>

    <!-- 加载中 -->
    <StackPanel IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <ProgressBar IsIndeterminate="True" Width="200" Foreground="#4169E1" />
      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=918}"
                 Foreground="#8A8F98" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- config_doc.md 渲染 (标题层级/图片/链接, 复刻 Vue 版 iframe 效果) -->
    <ScrollViewer IsVisible="{Binding DocAvailable}">
      <StackPanel Margin="36,28,36,40" Spacing="4">
        <DockPanel Margin="0,0,0,10">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=939}"
                     FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right"
                  Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2403}"
                  Click="OnEditOverviewClick" Background="#4169E1" Foreground="White"
                  CornerRadius="8" Padding="18,7" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding DocBlocks}" />
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=931}"
                   Foreground="#B0B4BC" FontSize="12" Margin="0,24,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- 回退引导: 后端未提供 config_doc.html 时 -->
    <ScrollViewer IsVisible="{Binding !DocAvailable}">
      <StackPanel IsVisible="{Binding !IsLoading}" Margin="36,28" Spacing="14" MaxWidth="720">
        <TextBlock Text="MyKeymap" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=932}"
                   Foreground="#C77700" FontSize="13" />
        <Border Height="1" Background="#E3E6EC" Margin="0,4" />
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=934}"
                   TextWrapping="Wrap" FontSize="14" />
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=935}"
                   FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=936}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=937}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=938}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>

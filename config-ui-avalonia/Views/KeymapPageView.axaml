<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyKeymap.Settings.ViewModels"
             xmlns:controls="using:MyKeymap.Settings.Views.Controls"
             x:Class="MyKeymap.Settings.Views.KeymapPageView"
             x:Name="Root"
             x:DataType="vm:KeymapPageViewModel">

  <!-- 键位图页 (复刻 views/Keymap.vue): 物理键盘网格 + 动作编辑面板 + 右侧备注汇总 -->
  <ScrollViewer Background="#F0F2F7">
    <StackPanel Orientation="Horizontal" Margin="24,20,24,28" Spacing="32" VerticalAlignment="Top">

      <StackPanel MinWidth="500">

        <!-- 页头: 模式名称 + 子模式上层信息 (label:503) -->
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,0,0,12">
          <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ParentInfo}" FontSize="13" Foreground="#8A8F98"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 键盘网格: 行 -> 键格 (选中蓝 / 禁用灰 / 已绑定绿 / 空键白) -->
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyboardRowVm">
              <ItemsControl ItemsSource="{Binding Keys}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyCellVm">
                    <Button Height="50" MinWidth="53" Padding="10,0" CornerRadius="6"
                            Background="{Binding Background}"
                            IsEnabled="{Binding IsEnabled}"
                            Foreground="#20242B" BorderBrush="#D5D9E2" BorderThickness="1"
                            Command="{Binding #Root.((vm:KeymapPageViewModel)DataContext).SelectKeyCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Label}"
                                 FontSize="{Binding #Root.((vm:KeymapPageViewModel)DataContext).KeyFontSize}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 动作编辑面板 -->
        <controls:ActionEditorPanel Margin="0,18,0,0" DataContext="{Binding Editor}" />
      </StackPanel>

      <!-- 右侧备注汇总 (复刻 ActionCommentTable) -->
      <StackPanel MinWidth="220" MaxWidth="340" Margin="0,36,0,0">
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=305}"
                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding CommentEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CommentEntryVm">
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding Comment}" FontSize="12" Foreground="#5A5F68"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>

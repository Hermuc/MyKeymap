<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyKeymap.Settings.ViewModels"
             xmlns:controls="using:MyKeymap.Settings.Views.Controls"
             x:Class="MyKeymap.Settings.Views.KeymapPageView"
             x:Name="Root"
             x:DataType="vm:KeymapPageViewModel">

  <!-- 键位图页 (复刻 views/Keymap.vue): 物理键盘网格 + 动作编辑面板 + 右侧备注汇总
       布局: 外层 Grid 只承载页面背景 (铺满内容区, 避免 Margin 露白),
       内层 Grid 带边距与裁剪; 左列 (页头/键盘/编辑面板) 固定不滚动, 右列备注汇总独立滚动 -->
  <Grid Background="#F0F2F7">
    <Grid ColumnDefinitions="Auto,*" Margin="24,20,24,28" ClipToBounds="True">

      <!-- 左列: 键位功能区 (固定, 无滚动器) -->
      <StackPanel MinWidth="500">

        <!-- 页头: 模式名称 + 子模式上层信息 (label:503) -->
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,0,0,12">
          <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ParentInfo}" FontSize="13" Foreground="#8A8F98"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 键盘网格: 行 -> 键格 (选中蓝 / 禁用灰 / 已绑定绿 / 空键白);
             键格放大后保持自然宽度左对齐 (10 键行 = 10*76 + 9*4 = 796px, 与编辑面板 800 基本对齐) -->
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyboardRowVm">
              <ItemsControl ItemsSource="{Binding Keys}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyCellVm">
                    <Button Height="50" MinWidth="76" Padding="10,0" CornerRadius="6"
                            Background="{Binding Background}"
                            IsEnabled="{Binding IsEnabled}"
                            Foreground="#20242B" BorderBrush="#D5D9E2" BorderThickness="1"
                            Command="{Binding #Root.((vm:KeymapPageViewModel)DataContext).SelectKeyCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Label}"
                                 FontSize="{Binding #Root.((vm:KeymapPageViewModel)DataContext).KeyFontSize}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 动作编辑面板 -->
        <controls:ActionEditorPanel Margin="0,10,0,0" DataContext="{Binding Editor}" />
      </StackPanel>

      <!-- 右列: 备注汇总 (复刻 ActionCommentTable, 独立滚动) -->
      <controls:CommentSummaryPanel Grid.Column="1" Margin="32,36,0,0"
                                    ItemsSource="{Binding CommentEntries}"
                                    LanguageTick="{Binding LanguageTick}" />
    </Grid>
  </Grid>
</UserControl>

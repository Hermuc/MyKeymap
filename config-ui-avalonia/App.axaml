<!-- 强制浅色主题变体: 页面背景全部为硬编码浅色系 (White / #F7F8FB / #FCFCFE 等),
     若跟随系统深色主题则默认前景变白, 形成白底白字 / 灰底白字,
     故固定 Light 以保证文字为深色可读。 -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:MyKeymap.Settings.Services"
             x:Class="MyKeymap.Settings.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <!-- 双语文案转换器: Binding 源为各 VM 的 LanguageTick, ConverterParameter 为文案键 -->
    <services:I18nConverter x:Key="Tr" />
    <services:IntToStringConverter x:Key="IntStr" />
    <services:BoolNotConverter x:Key="Not" />
    <services:StringNotEmptyConverter x:Key="NotEmpty" />
  </Application.Resources>

  <!-- 应用级样式：使用 Fluent 主题 (变体由 Application.RequestedThemeVariant 决定) -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
